.DS_Store
assets/.DS_Store
.vercel
dist/
node_modules/
supabase/.temp/

# Local clean-URL shims for simple static servers. Vercel uses the generated dist/ output.
/privatumzuege/
/bueroumzuege/
/seniorenumzuege/
/halteverbotszone/
/auslandsumzuege/
/aussenaufzug/
/umzug-frankfurt/
/ueber-uns/
/impressum/
/datenschutz/

# Local QA screenshots and recordings generated during browser checks.
/*.png
/*.mp4

# Source video uploads are converted to optimized webm assets for the site.
assets/**/*.mp4

# Editor and OS noise.
.idea/
.vscode/
*.swp

# Raw video source. Converted to optimized web assets before use.
# (2.4 GB .mov in repo root would otherwise land in git history.)
*.mov
*.MOV

# Unreferenced raw image drops (spaces in filenames, not used by any page).
/assets/Intro*
/assets/intro image*
/assets/stundenprice*
/assets/intro-family.webp

# One-off migration/recovery scripts. These wrote corrupted bytes into
# location pages in the past (stray \x02 in place of closing tags) --
# keep them out of the repo.
/recovered_script*.py
/scratch_update_*.py
/inject_service_pages.py
/update_heidelberg.py
/update_ludwigshafen.py

# Local scratch and backups.
*.bak
/diff.txt
/commands.txt
/prev_commands.txt
/old_heidelberg.html
/styles_recovered*.css
/standard_header.html

# Unreferenced icon drop (directory name has a trailing space).
"/icons "
/icons\ /
